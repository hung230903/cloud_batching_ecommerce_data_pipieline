# Airflow Docker Environment Variables
# Copy this file to .env and adjust the values

# Custom image name matching the Dockerfile build
AIRFLOW_IMAGE_NAME=glamira/airflow-batch:2.10.4

# User ID of the host machine (run `id -u` to get this)
AIRFLOW_UID=1000

# Absolute path to the project root on the host machine
# This is mounted into /opt/airflow/project inside the container
PROJECT_ROOT=/home/hung/Documents/PycharmProject/cloud_batching_ecommerce_data_pipieline

# Additional PIP requirements at runtime (prefer Dockerfile for production)
_PIP_ADDITIONAL_REQUIREMENTS=''
